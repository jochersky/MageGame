  specialTile: {fileID: 0}
  specialObject: {fileID: 0}
  specialEnemies: []
  spawnPoint: {x: 0, y: 0}
  greetingLines:
  - Hail, friend. You look strong and capable. Perhaps you can aid me.
  - I seek to slay a mighty beast that lurks around here.
  - However, the beast bested me, and I barely escaped with my life.
  - Defeat this fearsome foe, and you shall be rewarded. I have marked it for you.
  reminderLines:
  - Follow my mark and slay that incarnation of evil.
  noEnemiesLines:
  - I have come here hunting a great foe.
  - But this place is a wasteland. I must look elsewhere.
  successLines:
  - You have done it. By the Labyrinth, the beast is dead! I am saved!
  - Oh don't look at me like that. I haven't forgotten your reward.
  markColor: {r: 1, g: 0, b: 0, a: 1}
  markGlow: {fileID: 6961637745602742985, guid: 971c34d782473294fa6c7baecd7f1ca1, type: 3}
  reward: {fileID: 2467777248196494029, guid: d3cbab79a247d7841b314df9a10d6e78, type: 3}
