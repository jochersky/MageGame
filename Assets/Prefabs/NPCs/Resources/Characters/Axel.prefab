  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Axel
  sprite: {fileID: 1283180021649736767}
  outline: {fileID: 831906508752795542}
  dialogueBox: {fileID: 5944131923498316812}
  npcName: Axel
