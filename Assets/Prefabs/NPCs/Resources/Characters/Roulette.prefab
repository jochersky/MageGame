  m_Name: 
  m_EditorClassIdentifier: '::'
  outline: {fileID: 6505613740043205292}
  dialogueBox: {fileID: 4816933780892115529}
  npcName: Roulette
  nameTextBox: {fileID: 335095857717337690}
  text: {fileID: 5863862873486810491}
  dialogue:
  - 'Hey there, hotshot. Care to roll the dice? '
  textSpeed: 0.025
  room: {fileID: 0}
  specialEnemy: {fileID: 0}
  specialTile: {fileID: 0}
  specialObject: {fileID: 0}
  specialEnemies: []
  spawnPoint: {x: 0, y: 0}
  declineLines:
  - Your loss. I'll see you later.
  fiveKindLines:
  - Whoa! Five of a kind! Incredible, I've never seen this before!
  - You are now the proud owner of this great family heirloom. Treasure it dearly.
  fourKindLines:
  - Wow! Four of a kind! Looks like a big payday for you, pal.
  threeKindLines:
  - Three of kind, not bad. That's triple back for you.
  twoPairLines:
  - Two pair it seems. The worst victory, but a victory nonetheless.
  onePairLines:
  - 'Just one pair. I''ll be keeping that wager. '
  fullHouseLines:
  - Oh, a full house! That'll heal you right up. And your money back of course.
  straightLines:
  - A straight. Straight to the exit with you, that is.
  bustLines:
  - Ouch, a bust, That's gotta hurt. Nothing to do but try again, right?
